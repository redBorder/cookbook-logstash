filter {
  if ![tag] or [tag] == 0 {
    ruby {
      init => '
        # TODO 
        #   populate necessasary values
        #   rescues
        require "ipaddr"
        require "yaml"

        $sensor_homenets = YAML.safe_load(File.read("/etc/logstash/sflow_homenets/default.yml")) rescue {}
      '
      code => '
        sensor_ip = event.get("peer_ip_src")
        homenets = $sensor_homenets[sensor_ip] || {}

        ip_src = event.get("ip_src")
        ip_dst = event.get("ip_dst")

        # Check source IP
        if ip_src
          homenets.each do |network|
            if IPAddr.new(network).include?(IPAddr.new(ip_src))
              event.tag("is_src_internal")
              break
            end
          end
        end

        # Check destination IP
        if ip_dst
          homenets.each do |network|
            if IPAddr.new(network).include?(IPAddr.new(ip_dst))
              event.tag("is_dst_internal")
              break
            end
          end
        end
      '
    }
    
    if "is_src_internal" in [tags] and "is_dst_internal" in [tags] {
      mutate { add_field => { "direction" => "internal" } }
    } else if "is_src_internal" in [tags] {
      mutate { add_field => { "direction" => "upstream" } }
    } else if "is_dst_internal" in [tags] {
      mutate { add_field => { "direction" => "downstream" } }
    } else {
      mutate { add_field => { "direction" => "N/A" } }
    }
  } else if [tag] == 1 {
      mutate { add_field => { "direction" => "downstream" } }
  } else if [tag] == 3 {
      mutate { add_field => { "direction" => "internal" } }
  }

  <% if @split_traffic_logstash %>
  if [tag2] {
    ruby {
      init => '
        require "ipaddr"
        # Precompute proxy node data
        $proxy_nodes = <%= 
          return [] unless @proxy_nodes
          proxy_nodes = []
          # # Enrich data from input (proxy nodes)
          @proxy_nodes.each do |proxy_node|
            next if proxy_node["redborder"].nil?

            # Build role name for Chef
            role_name = "rBsensor-#{proxy_node["name"].gsub("rbproxy-","")}"
            begin
              role = Chef::Role.load(role_name)
            rescue
              next
            end

            next unless role.override_attributes

            interfaces_filters = []
            interfaces = role.override_attributes["redborder"]["interfaces"] || []
            interfaces.each do |iface_key, iface_data|
              next unless iface_data["observation_id_filters"] && !iface_data["observation_id_filters"].empty?

              iface_data['observation_id_filters'].each do |f|
                interfaces_filters.push f
              end
            end

            proxy_nodes.push({
              ipaddress: proxy_node['ipaddress'],
              observation_id_filters: interfaces_filters
            })
          end
          proxy_nodes
        %>
      '
      code => '
        ip_src = IPAddr.new(event.get("ip_src")) rescue nil
        ip_dst = IPAddr.new(event.get("ip_dst")) rescue nil
        tag2   = event.get("tag2")
        observation_tag2 = tag2

        sensor_ip = event.get("peer_ip_src")

        proxy_node = $proxy_nodes.find { |n| n[:ipaddress] == sensor_ip }
        if proxy_node && (ip_src || ip_dst) && proxy_node[:observation_id_filters]
          proxy_node[:observation_id_filters].each do |filter|
            subnet = IPAddr.new(filter["subnet"]) rescue nil
            observation_id = filter["observation_id"]
            next unless subnet

            if subnet.include?(ip_src) || subnet.include?(ip_dst)
              observation_tag2 = observation_id
              break
            end
          end
        end

        event.set("tag2", observation_tag2) if tag2 != observation_tag2
      '
    }
  }
  <% end %>
}
