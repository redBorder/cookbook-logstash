<%#
Mar 02 16:40:50 jenkins-ljblanco.redborder.cluster logstash[356622]: [2026-03-02T16:40:50,883][INFO ][logstash.javapipeline    ][sflow-pipeline] Starting pipeline
{:pipeline_id=>"sflow-pipeline", "pipeline.workers"=>3, "pipeline.batch.size"=>125, "pipeline.batch.delay"=>50, "pipeline.max_inflight"=>375, 
"pipeline.sources"=>["/etc/logstash/pipelines/sflow/00_input.conf", 
"/etc/logstash/pipelines/sflow/01_tagging.conf", 
"/etc/logstash/pipelines/sflow/02_normalization.conf", 
"/etc/logstash/pipelines/sflow/03_enrichment.conf", 
"/etc/logstash/pipelines/sflow/04_field_conversion.conf", 
"/etc/logstash/pipelines/sflow/99_output.conf"], :thread=>"#<Thread:0x578d2f run>"}
%>

filter {
  if ![tag] or [tag] == 0 {
    <%# find like in a hashmap homenets = Hashmap[ip] %>
    <%#= translate {
      destination => "homenets"
      field       => "peer_ip_src"
      dictionary  => {
        "10.0.50.91" => "10.1.0.0/16|192.168.10.0/24",
        "10.0.50.92" => "172.16.0.0/12"
         @flow_nodes.map { |flow_node|
          ip = flow_node[:ipaddress]
          homenets = flow_node.dig('redborder','homenets') || []
          homenets_str = homenets.map { |h| h['value'] }.join('|') # use '|' as delimiter
          %Q("#{ip}" => "#{homenets_str}")
        }.join(",\n  ") 
      }
    } %> 

    <% homenets = %w[10.1.0.0/16 192.168.10.0/24] %>

    cidr {
      address => "%{ip_src}"
      <%#= network_path => "/etc/logstash/sflow_homenets/default.txt" %>
      network => <%= homenets %>
      add_tag => [ "is_src_internal" ]
    }
    cidr {
      address => "%{ip_dst}"
      <%#= network_path => "/etc/logstash/sflow_homenets/default.txt" %>
      network => <%= homenets %>
      add_tag => [ "is_dst_internal" ]
    }
    if "is_src_internal" in [tags] and "is_dst_internal" in [tags] {
      mutate { add_field => { "direction" => "internal" } }
    } else if "is_src_internal" in [tags] {
      mutate { add_field => { "direction" => "upstream" } }
    } else if "is_dst_internal" in [tags] {
      mutate { add_field => { "direction" => "downstream" } }
    } else {
      mutate { add_field => { "direction" => "please_define_homenets_in_sensor" } }
    }

    <%# Clear helper tag %>
    mutate {
      remove_tag => [ "is_src_internal", "is_dst_internal" ]
    }
  } else if [tag] == 1 {
      mutate { add_field => { "direction" => "downstream" } }
  } else if [tag] == 3 {
      mutate { add_field => { "direction" => "internal" } }
  }

  <% if @split_traffic_logstash %>
  if [tag2] {
    <% @proxy_nodes.each do |proxy_node| %>
      <% if !proxy_node["redborder"].nil? %>
      if [peer_ip_src] == "<%=proxy_node[:ipaddress]%>" {
        ruby {
          code => "
            require 'ipaddr'
  
            ip_src = IPAddr.new(event.get('ip_src'))
            ip_dst = IPAddr.new(event.get('ip_dst'))
  
            tag2 = event.get('tag2')
            observation_tag2 = tag2

            <% role_name = "rBsensor-#{proxy_node.name.gsub('rbproxy-','')}" %>
            <% proxy_role = Chef::Role.load role_name rescue nil %>

            <% if proxy_role && proxy_role.override_attributes && proxy_role.override_attributes['redborder'] && proxy_role.override_attributes['redborder']['interfaces'] && !proxy_role.override_attributes['redborder']['interfaces'].empty? %>
              <% proxy_role.override_attributes['redborder']['interfaces'].each do |iface_key, _orig_iface| %>
              <% unless proxy_role.override_attributes['redborder']['interfaces'][iface_key]['observation_id_filters'].empty? %>
              observation_id_filters = <%= proxy_role.override_attributes['redborder']['interfaces'][iface_key]['observation_id_filters'].to_s.gsub('"', "'") %>
  
              observation_id_filters.each do |filter|
                subnet = IPAddr.new(filter['subnet'])
                observation_id = filter['observation_id']
  
                if subnet.include?(ip_src)
                  observation_tag2 = observation_id
                  break
                end
              end
  
              if observation_tag2 == tag2
                observation_id_filters.each do |filter|
                  subnet = IPAddr.new(filter['subnet'])
                  observation_id = filter['observation_id']
  
                  if subnet.include?(ip_dst)
                    observation_tag2 = observation_id
                    break
                  end
                end
              end
              <% end %>
              <% end %>
            <%end %>
  
            event.set('tag2', observation_tag2) if tag2 != observation_tag2
  
            "
          }
        }
      <% end %>
    <% end %>
    }
  <% end %>
}
