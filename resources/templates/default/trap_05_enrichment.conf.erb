filter {
  <% @sensor_nodes.each do |node| %>
    <% next unless node.name.to_s.start_with?("rbtrap-") %>
    <% next if node["redborder"].nil? %>
    <% sensor_uuid = node["redborder"]["sensor_uuid"].to_s %>
    <% next if sensor_uuid.empty? %>
    <% sensor_ip   = (node["ipaddress"] || node["redborder"]["ipaddress"]).to_s %>
    <% sensor_name = (node["rbname"].nil? ? node.name : node["rbname"]) %>
  if <% if sensor_ip.empty? %>[sensor_uuid] == "<%= sensor_uuid %>"<% else %>[host] == "<%= sensor_ip %>" or [sensor_uuid] == "<%= sensor_uuid %>"<% end %> {
    mutate {
      replace => {
        "sensor_uuid" => "<%= sensor_uuid %>"
      }
    }
    if ![sensor_name] {
      mutate {
        add_field => {
          "sensor_name" => "<%= sensor_name %>"
        }
      }
    }
    <% %w(deployment deployment_uuid namespace namespace_uuid market market_uuid
          organization organization_uuid service_provider service_provider_uuid
          campus campus_uuid building building_uuid floor floor_uuid).each do |location| %>
      <% value = node["redborder"][location] %>
      <% next if value.nil? or value.to_s.empty? %>
    if ![<%= location %>] {
      mutate {
        add_field => {
          "<%= location %>" => "<%= value %>"
        }
      }
    }
    <% end %>
  }
  <% end %>

  if ![sensor_ip] {
    mutate {
      copy => { "host" => "sensor_ip" }
    }
  }
}
